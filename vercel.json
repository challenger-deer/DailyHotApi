{
  "buildCommand": "npx esbuild src/app.tsx --bundle --platform=node --format=esm --target=node20 --outfile=api/_app.js --packages=external --jsx=automatic --jsx-import-source=hono/jsx",
  "builds": [
    {
      "src": "api/index.ts",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "api/index.ts"
    }
  ]
}
